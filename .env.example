# EmailJS Credentials Configuration
# Copy this file to .env and replace the values with your actual EmailJS configuration.
# In Next.js, client-exposed environment variables must be prefixed with NEXT_PUBLIC_.
# (EmailJS service/template/public keys are designed to live in client code.)

# The Service ID generated for your email service (e.g., Gmail, Outlook)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id

# The Template ID generated in your EmailJS dashboard
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# The Public Key (formerly User ID) found under Account -> API Keys in EmailJS dashboard
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
